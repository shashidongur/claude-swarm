{
  "bash_deny": [
    "pulls/[0-9]+/merge",
    "--method",
    "-X ?(PUT|PATCH|DELETE|POST)",
    "push .*:(refs/heads/)?(main|master|swarm/state)",
    "push .*\\+",
    "push --force",
    "push -f\\b",
    "curl|wget .*api\\.github\\.com",
    "git -C \\.swarm",
    "\\.swarm/lib",
    "\\$RUNNER_TEMP|claude-execution-output",
    "(^|[;&|] *)(env|printenv)( |$)",
    "/proc/self/environ"
  ],
  "classes": {
    "critic": {
      "allowed": "Read,Glob,Grep,LS,TodoWrite,Write,Edit,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*),Bash(git fetch:*),Bash(git rev-parse:*),Bash(git ls-files:*),Bash(ls:*),Bash(cat:*),Bash(head:*),Bash(tail:*),Bash(wc:*),Bash(find:*),Bash(grep:*),Bash(rg:*),Bash(jq:*),Bash(yq:*),Bash(gh issue view:*),Bash(gh issue list:*),Bash(gh pr view:*),Bash(gh pr diff:*),Bash(gh pr checks:*),Bash(gh run view:*),Bash(gh run list:*),Bash(gh api repos/*/issues/*:*),Bash(gh search:*),Bash(date:*),Bash(mkdir:*)",
      "disallowed": "",
      "permissions": "read",
      "write_roots": [
        ".swarm-run/critic.json"
      ]
    },
    "read": {
      "allowed": "Read,Glob,Grep,LS,TodoWrite,Write,Edit,Bash(git diff:*),Bash(git log:*),Bash(git show:*),Bash(git status:*),Bash(git fetch:*),Bash(git rev-parse:*),Bash(git ls-files:*),Bash(ls:*),Bash(cat:*),Bash(head:*),Bash(tail:*),Bash(wc:*),Bash(find:*),Bash(grep:*),Bash(rg:*),Bash(jq:*),Bash(yq:*),Bash(node:*),Bash(npm test:*),Bash(npm run:*),Bash(gh issue view:*),Bash(gh issue list:*),Bash(gh pr view:*),Bash(gh pr diff:*),Bash(gh pr checks:*),Bash(gh run view:*),Bash(gh run list:*),Bash(gh api repos/*/issues/*:*),Bash(gh search:*),Bash(date:*),Bash(mkdir:*)",
      "disallowed": "",
      "permissions": "read",
      "write_roots": [
        ".swarm-run/artifacts",
        ".swarm-run/result.json"
      ]
    },
    "write": {
      "allowed": "Read,Glob,Grep,LS,TodoWrite,Write,Edit,MultiEdit,Bash",
      "disallowed": "Bash(git push --force*),Bash(git push -f*),Bash(git push origin main*),Bash(git push origin HEAD:main*),Bash(git push origin HEAD:refs/heads/main*),Bash(gh pr merge*),Bash(gh pr review*),Bash(gh secret*),Bash(gh repo edit*),Bash(gh workflow*),Bash(gh label*),Bash(gh issue edit*),Bash(gh issue close*),Bash(gh api -X PATCH*),Bash(gh api -X PUT*),Bash(gh api -X DELETE*),Bash(gh api --method*),Bash(rm -rf .git*)",
      "permissions": "write",
      "write_roots": [
        ".",
        ".swarm-run/artifacts",
        ".swarm-run/result.json"
      ]
    }
  },
  "critic_defaults": {
    "timeout": 15,
    "turns": 40
  },
  "deny_paths": [
    ".swarm-run/brief.md",
    ".swarm-run/state.json",
    ".swarm-run/pipeline.json",
    ".swarm-run/config.json",
    ".swarm-run/settings.json",
    ".swarm-run/evidence/**",
    ".swarm-run/validation.json",
    ".swarm-run/previous-attempt.md"
  ],
  "edges": {
    "budgeted": [
      "code-review",
      "qa",
      "security",
      "compliance",
      "a11y",
      "threat-model",
      "critic",
      "ci-red"
    ],
    "free_rework": [
      "owner-reject",
      "owner-redo"
    ]
  },
  "emoji": {
    "a11y": "♿",
    "analyst": "🎯",
    "architect": "📐",
    "code-review": "🔍",
    "compliance": "📋",
    "critic": "⚖️",
    "dev": "🔨",
    "dispatch": "🧭",
    "gate": "🛎️",
    "planner": "🗺️",
    "qa": "✅",
    "release": "🚀",
    "retro": "📓",
    "security": "🔐",
    "test-writer": "🧪",
    "threat-model": "🛡️",
    "triage": "🔎",
    "ux": "🎨",
    "watchdog": "🐕"
  },
  "limits": {
    "cost_usd_per_issue": 75,
    "critic_rework": 1,
    "evidence_fires_per_issue": 2,
    "open_prs": 3,
    "pr_files": 25,
    "pr_lines": 800,
    "pushes_per_pr_per_day": 10,
    "question_rounds": 2,
    "ratelimit_backoff_minutes": 180,
    "rework_budget": 5,
    "runaway_per_hour": 10,
    "runner_minutes_month": 1500,
    "usd_month": 200
  },
  "memory_fenced": [
    "gotchas/auto/**",
    "postmortems/**",
    "runs/**"
  ],
  "models": {
    "critic_tier_for": {
      "cheap": "default",
      "default": "strong",
      "strong": "default"
    },
    "retry_tier_for": {
      "cheap": "cheap",
      "default": "default",
      "strong": "default"
    },
    "tiers": {
      "cheap": "claude-haiku-4-5",
      "default": "claude-sonnet-5",
      "strong": "claude-opus-5"
    }
  },
  "paths": {
    "full": [
      "triage",
      "requirements",
      "design",
      "architecture",
      "build",
      "test",
      "security",
      "release",
      "retro"
    ],
    "short": [
      "triage",
      "requirements",
      "build",
      "test",
      "security",
      "release",
      "retro"
    ]
  },
  "protected_paths": [
    ".github/**",
    ".swarm/**",
    ".swarm-run/**",
    ".claude/**",
    "**/.claude/**",
    "CLAUDE.md",
    ".mcp.json",
    ".claude-plugin/**",
    "**/*.pem",
    "**/*.p8",
    "**/*.key",
    ".env*",
    "**/*.keystore"
  ],
  "restore_from_base": [
    ".claude",
    "CLAUDE.md",
    ".mcp.json",
    ".claude-plugin"
  ],
  "stages": [
    {
      "gate": "none",
      "label": "swarm:triage",
      "name": "triage",
      "on_short": "run",
      "roles": [
        {
          "artifacts": [
            "triage.json"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "conventions.md",
            "decisions.md"
          ],
          "name": "triage",
          "reads": [],
          "tier": "cheap",
          "timeout": 10,
          "turns": 40,
          "verdicts": [
            "pass",
            "duplicate",
            "blocked"
          ]
        }
      ]
    },
    {
      "gate": {
        "name": "requirements",
        "on_short": "skip",
        "reject_to": "analyst"
      },
      "label": "swarm:requirements",
      "name": "requirements",
      "on_short": "run",
      "roles": [
        {
          "artifacts": [
            "requirements.md"
          ],
          "can_escalate_path": true,
          "class": "read",
          "critic": {
            "on_short": "skip",
            "rubric": "requirements",
            "threshold": 70
          },
          "memory": [
            "conventions.md",
            "decisions.md",
            "preferences.md"
          ],
          "name": "analyst",
          "reads": [
            "triage.json"
          ],
          "tier": "default",
          "timeout": 25,
          "turns": 80,
          "verdicts": [
            "pass",
            "question",
            "blocked"
          ]
        }
      ]
    },
    {
      "gate": "none",
      "label": "swarm:design",
      "name": "design",
      "on_short": "skip",
      "roles": [
        {
          "artifacts": [
            "design.md"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "conventions.md",
            "preferences.md"
          ],
          "name": "ux",
          "reads": [
            "requirements.md"
          ],
          "tier": "default",
          "timeout": 25,
          "turns": 80,
          "verdicts": [
            "pass",
            "blocked"
          ]
        },
        {
          "artifacts": [
            "a11y.md"
          ],
          "class": "read",
          "critic": {
            "enabled": false,
            "on_short": "skip",
            "rubric": "design",
            "threshold": 65
          },
          "memory": [
            "conventions.md"
          ],
          "name": "a11y",
          "reads": [
            "requirements.md",
            "design.md"
          ],
          "rework_max": 1,
          "rework_to": "ux",
          "tier": "default",
          "timeout": 15,
          "turns": 50,
          "verdicts": [
            "pass",
            "rework",
            "blocked"
          ]
        }
      ]
    },
    {
      "gate": {
        "name": "architecture",
        "on_short": "skip",
        "reject_to": "architect"
      },
      "label": "swarm:architecture",
      "name": "architecture",
      "on_short": "skip",
      "roles": [
        {
          "artifacts": [
            "adr.md",
            "openapi.yaml",
            "migration-plan.md",
            "flags.md",
            "rollback.md"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "conventions.md",
            "decisions.md",
            "adrs/INDEX.md",
            "gotchas/INDEX.md"
          ],
          "name": "architect",
          "reads": [
            "requirements.md",
            "design.md"
          ],
          "tier": "strong",
          "timeout": 40,
          "turns": 120,
          "verdicts": [
            "pass",
            "blocked"
          ]
        },
        {
          "artifacts": [
            "threat-model.md"
          ],
          "class": "read",
          "critic": {
            "must_differ_from": "architect",
            "on_short": "skip",
            "rework_to": "architect",
            "rubric": "architecture",
            "threshold": 70,
            "tier": "default"
          },
          "memory": [
            "conventions.md"
          ],
          "name": "threat-model",
          "reads": [
            "requirements.md",
            "adr.md",
            "openapi.yaml",
            "migration-plan.md"
          ],
          "rework_max": 1,
          "rework_to": "architect",
          "tier": "default",
          "timeout": 20,
          "turns": 60,
          "verdicts": [
            "pass",
            "rework",
            "blocked"
          ]
        }
      ]
    },
    {
      "gate": "none",
      "label": "swarm:build",
      "name": "build",
      "on_short": "run",
      "roles": [
        {
          "artifacts": [
            "plan.md"
          ],
          "class": "read",
          "creates_subissues": true,
          "critic": {
            "enabled": false,
            "rubric": "plan",
            "threshold": 60
          },
          "memory": [
            "conventions.md",
            "gotchas/INDEX.md"
          ],
          "name": "planner",
          "on_short": "skip",
          "reads": [
            "requirements.md",
            "design.md",
            "adr.md",
            "openapi.yaml",
            "migration-plan.md",
            "flags.md"
          ],
          "tier": "default",
          "timeout": 20,
          "turns": 60,
          "verdicts": [
            "pass",
            "blocked"
          ]
        },
        {
          "artifacts": [
            "test-plan.md",
            "pr-body.md"
          ],
          "ci_on_failure": "continue",
          "class": "write",
          "critic": "none",
          "evidence_after": "ci",
          "memory": [
            "conventions.md",
            "gotchas/INDEX.md",
            "preferences.md"
          ],
          "name": "test-writer",
          "opens_pr": true,
          "reads": [
            "requirements.md",
            "plan.md",
            "openapi.yaml",
            "design.md"
          ],
          "tier": "default",
          "timeout": 45,
          "turns": 150,
          "verdicts": [
            "pass",
            "blocked"
          ]
        },
        {
          "artifacts": [],
          "ci_on_failure": "rework:dev:<lane>",
          "class": "write",
          "critic": "none",
          "evidence_after": "ci",
          "memory": [
            "conventions.md",
            "gotchas/INDEX.md",
            "preferences.md"
          ],
          "name": "dev",
          "per_lane": true,
          "reads": [
            "requirements.md",
            "plan.md",
            "adr.md",
            "openapi.yaml",
            "migration-plan.md",
            "flags.md",
            "test-plan.md",
            "design.md"
          ],
          "specialist": true,
          "tier": "default",
          "timeout": 75,
          "turns": 250,
          "verdicts": [
            "pass",
            "blocked"
          ]
        },
        {
          "artifacts": [
            "review-<lane>-a<attempt>.md"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "conventions.md",
            "preferences.md"
          ],
          "must_differ_from": "dev",
          "name": "code-review",
          "per_lane": true,
          "reads": [
            "requirements.md",
            "plan.md",
            "adr.md",
            "openapi.yaml",
            "test-plan.md"
          ],
          "requires_ci": "success",
          "rework_to": "dev:<lane>",
          "tier": "strong",
          "timeout": 25,
          "turns": 80,
          "verdicts": [
            "pass",
            "rework",
            "blocked"
          ]
        }
      ]
    },
    {
      "evidence_before": {
        "max_fires": "evidence_fires_per_issue",
        "on_failure": "run_role",
        "on_short": "skip",
        "when": "walkthrough_when",
        "workflow": "test"
      },
      "gate": "none",
      "label": "swarm:test",
      "name": "test",
      "on_short": "run",
      "roles": [
        {
          "artifacts": [
            "qa-report.md"
          ],
          "class": "read",
          "critic": {
            "enabled": false,
            "rubric": "report",
            "threshold": 65
          },
          "memory": [
            "conventions.md",
            "gotchas/INDEX.md"
          ],
          "name": "qa",
          "reads": [
            "requirements.md",
            "test-plan.md",
            "plan.md"
          ],
          "requires_ci": "success",
          "requires_evidence": "success",
          "rework_to": "dev:<lane>",
          "tier": "default",
          "timeout": 30,
          "turns": 80,
          "verdicts": [
            "pass",
            "rework",
            "blocked"
          ]
        }
      ]
    },
    {
      "evidence_before": {
        "max_fires": "evidence_fires_per_issue",
        "on_failure": "run_role",
        "on_short": "skip",
        "workflow": "security"
      },
      "gate": "none",
      "label": "swarm:security",
      "name": "security",
      "on_short": "run",
      "roles": [
        {
          "artifacts": [
            "security-report.md"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "conventions.md"
          ],
          "name": "security",
          "on_short": "when_scan_changed",
          "reads": [
            "threat-model.md",
            "adr.md"
          ],
          "requires_scan": "success",
          "rework_to": "dev:<lane>",
          "tier": "default",
          "timeout": 20,
          "turns": 60,
          "verdicts": [
            "pass",
            "rework",
            "blocked"
          ]
        },
        {
          "artifacts": [
            "compliance.md"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "conventions.md",
            "decisions.md"
          ],
          "name": "compliance",
          "on_short": "sensitive_only",
          "reads": [
            "requirements.md",
            "adr.md",
            "openapi.yaml",
            "migration-plan.md",
            "threat-model.md",
            "security-report.md"
          ],
          "rework_to": "dev:<lane>",
          "tier": "strong",
          "timeout": 20,
          "turns": 60,
          "verdicts": [
            "pass",
            "rework",
            "blocked"
          ]
        }
      ]
    },
    {
      "gate": {
        "kind": "merge",
        "name": "release",
        "reject_to": "analyst-feedback"
      },
      "label": "swarm:release",
      "name": "release",
      "on_short": "run",
      "roles": [
        {
          "artifacts": [
            "release.md",
            "pr-body.md"
          ],
          "class": "write",
          "critic": {
            "job": "separate",
            "on_short": "run",
            "rubric": "release",
            "threshold": 70
          },
          "lands_pending": true,
          "memory": [
            "preferences.md"
          ],
          "name": "release",
          "reads": [
            "requirements.md",
            "qa-report.md",
            "security-report.md",
            "compliance.md",
            "a11y.md"
          ],
          "tier": "default",
          "timeout": 25,
          "turns": 80,
          "verdicts": [
            "pass",
            "blocked"
          ]
        }
      ]
    },
    {
      "gate": "none",
      "label": "swarm:retro",
      "name": "retro",
      "on_short": "run",
      "once_per_merge": true,
      "roles": [
        {
          "artifacts": [
            "postmortem.md"
          ],
          "class": "read",
          "critic": "none",
          "memory": [
            "MEMORY.md",
            "postmortems/INDEX.md",
            "adrs/INDEX.md"
          ],
          "name": "retro",
          "reads": [
            "requirements.md",
            "adr.md",
            "qa-report.md",
            "release.md"
          ],
          "tier": "default",
          "timeout": 20,
          "turns": 60,
          "verdicts": [
            "pass",
            "blocked"
          ],
          "writes_memory": "pr"
        }
      ],
      "trigger": "merged"
    }
  ],
  "v": 2,
  "verdict_edges": {
    "*.blocked": "block:agent-output",
    "*.pass": "next",
    "a11y.rework": "rework:ux",
    "analyst.question": "gate:question",
    "code-review.rework": "rework:dev:<lane>",
    "compliance.rework": "rework:{result.rework_to}",
    "dev.rework": "fire:dev",
    "qa.rework": "rework:{result.rework_to}",
    "security.rework": "rework:{result.rework_to}",
    "threat-model.rework": "rework:architect",
    "triage.duplicate": "park:duplicate"
  }
}
