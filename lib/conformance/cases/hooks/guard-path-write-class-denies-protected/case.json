{
  "script": "lib/hooks/guard-path.sh",
  "env": {
    "SWARM_WRITE_ROOTS": ".:.swarm-run/artifacts:.swarm-run/result.json",
    "SWARM_PROTECTED": ".github/**:.swarm/**:.claude/**:**/.claude/**:CLAUDE.md:.mcp.json:.claude-plugin/**:**/*.pem:**/*.p8:**/*.key:.env*:**/*.keystore",
    "SWARM_DENY": ".swarm-run/brief.md:.swarm-run/state.json:.swarm-run/pipeline.json:.swarm-run/config.json:.swarm-run/settings.json:.swarm-run/evidence/**:.swarm-run/validation.json:.swarm-run/previous-attempt.md"
  },
  "stdin": "{\"tool_name\":\"Write\",\"tool_input\":{\"file_path\":\".github/workflows/ci.yml\",\"content\":\"x\"}}",
  "expect": {
    "exit": 2,
    "stdout_contains": [
      "is a protected path"
    ]
  }
}
